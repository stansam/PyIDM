/* Modern Dark Theme for PyIDM — Aligned with page.jfif & compact.jfif */

/* Base & Global Widget Typography */
QWidget {
    background-color: #181825;
    color: #cdd6f4;
    font-family: "Segoe UI", -apple-system, Roboto, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #181825;
    color: #cdd6f4;
}

/* Explicit High-Contrast Text for Dialogs & Widgets */
QLabel {
    background-color: transparent;
    color: #cdd6f4;
}

QLabel#SidebarHeading {
    color: #89b4fa;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 6px 4px 2px 4px;
}

QCheckBox, QRadioButton {
    background-color: transparent;
    color: #cdd6f4;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #27273a;
    border: 1px solid #45475a;
    border-radius: 3px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3b82f6;
    border-color: #60a5fa;
}

QGroupBox {
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    margin-top: 14px;
    padding-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #89b4fa;
}

/* Text Editors & Browsers inside Dialogs */
QTextEdit, QTextBrowser {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 4px;
    selection-background-color: #45475a;
    selection-color: #ffffff;
}

/* Sidebar navigation */
QListWidget, QTreeWidget {
    background-color: #11111b;
    border: none;
    border-right: 1px solid #313244;
    color: #a6adc8;
    font-size: 13px;
    padding: 4px;
}

QListWidget::item, QTreeWidget::item {
    height: 34px;
    padding-left: 8px;
    border-radius: 4px;
    margin: 2px 4px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #313244;
    color: #89b4fa;
    font-weight: bold;
}

/* Download Table */
QTableView {
    background-color: #181825;
    alternate-background-color: #1e1e2e;
    color: #cdd6f4;
    gridline-color: #27273a;
    selection-background-color: #313244;
    selection-color: #89b4fa;
    border: 1px solid #313244;
    border-radius: 6px;
    font-size: 13px;
}

QHeaderView {
    background-color: #11111b;
    border: none;
}

QHeaderView::section {
    background-color: #11111b;
    color: #a6adc8;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #313244;
    border-right: 1px solid #27273a;
    font-weight: bold;
}

QTableCornerButton::section {
    background-color: #11111b;
    border: none;
    border-bottom: 2px solid #313244;
    border-right: 1px solid #27273a;
}

/* ToolBar & Action Header */
QToolBar {
    background-color: #11111b;
    border-bottom: 1px solid #313244;
    spacing: 8px;
    padding: 6px 12px;
}

QToolButton {
    background-color: transparent;
    color: #cdd6f4;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #27273a;
    border-color: #45475a;
    color: #ffffff;
}

QToolButton:pressed {
    background-color: #3b3d56;
}

/* Standard Push Buttons — High Contrast Dark Surface */
QPushButton {
    background-color: #27273a;
    color: #cdd6f4;
    border: 1px solid #3e4058;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3b3d56;
    border-color: #89b4fa;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1e1e2e;
}

QPushButton:checked {
    background-color: #3b82f6;
    color: #ffffff;
    border-color: #60a5fa;
    font-weight: bold;
}

/* Specific Toolbar Push Buttons (Sort & Mode Toggle) */
QPushButton#SortButton, QPushButton#CompactModeButton {
    background-color: #27273a;
    color: #cdd6f4;
    border: 1px solid #3e4058;
}

QPushButton#SortButton:hover, QPushButton#CompactModeButton:hover {
    background-color: #3b3d56;
    border-color: #89b4fa;
    color: #ffffff;
}

QPushButton#CompactModeButton:checked {
    background-color: #27273a;
    color: #89b4fa;
    border: 1px solid #89b4fa;
}

/* Primary Action & Dialog Default Buttons */
QDialogButtonBox QPushButton {
    min-width: 75px;
}

/* Compact Sidebar & Buttons */
QWidget#CompactSidebar {
    background-color: #11111b;
    border-right: 1px solid #313244;
}

QWidget#CompactSidebar QPushButton {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0px;
}

QWidget#CompactSidebar QPushButton:hover {
    background-color: #27273a;
    border-color: #89b4fa;
}

QWidget#CompactSidebar QPushButton:pressed {
    background-color: #3b3d56;
}

/* Input Fields */
QLineEdit, QSpinBox, QComboBox {
    background-color: #27273a;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px 8px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #89b4fa;
    color: #ffffff;
}

QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #313244;
    selection-color: #89b4fa;
    border: 1px solid #45475a;
    padding: 4px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #313244;
    background-color: #181825;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #11111b;
    color: #a6adc8;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

QTabBar::tab:selected {
    background-color: #181825;
    color: #89b4fa;
    font-weight: bold;
    border-top: 2px solid #89b4fa;
}

/* Context Menus */
QMenu {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}

/* Modern Sleek Scrollbars */
QScrollBar:vertical {
    background-color: #11111b;
    width: 10px;
    margin: 0px;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #313244;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #45475a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #11111b;
    height: 10px;
    margin: 0px;
    border: none;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #313244;
    min-width: 24px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #45475a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Status Bar & Footer */
QStatusBar {
    background-color: #11111b;
    color: #cdd6f4;
    border-top: 1px solid #313244;
    padding: 4px;
}

QStatusBar QLabel {
    color: #cdd6f4;
    background-color: transparent;
    padding-left: 6px;
}

QLabel#SpeedIndicator {
    color: #89b4fa;
    font-weight: bold;
    padding-right: 16px;
}

QSplitter::handle {
    background-color: #313244;
}
