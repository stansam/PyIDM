/* Modern Dark Theme for PyIDM — Aligned with page.jfif & compact.jfif */
QMainWindow, QDialog {
    background-color: #181825;
    color: #cdd6f4;
    font-family: "Segoe UI", -apple-system, Roboto, sans-serif;
}

/* Sidebar navigation */
QListWidget, QTreeWidget {
    background-color: #11111b;
    border: none;
    border-right: 1px solid #313244;
    color: #a6adc8;
    font-size: 13px;
    padding: 4px;
}

QListWidget::item, QTreeWidget::item {
    height: 32px;
    padding-left: 8px;
    border-radius: 4px;
    margin: 2px 4px;
}

QListWidget::item:hover, QTreeWidget::item:hover {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #313244;
    color: #89b4fa;
    font-weight: bold;
}

/* Download Table */
QTableView {
    background-color: #181825;
    alternate-background-color: #1e1e2e;
    color: #cdd6f4;
    gridline-color: #27273a;
    selection-background-color: #313244;
    selection-color: #89b4fa;
    border: 1px solid #313244;
    border-radius: 6px;
    font-size: 13px;
}

QHeaderView::section {
    background-color: #11111b;
    color: #a6adc8;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #313244;
    border-right: 1px solid #27273a;
    font-weight: bold;
}

/* ToolBar & Action Header */
QToolBar {
    background-color: #11111b;
    border-bottom: 1px solid #313244;
    spacing: 8px;
    padding: 6px 12px;
}

QToolButton {
    background-color: transparent;
    color: #cdd6f4;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 10px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #313244;
    border-color: #45475a;
}

QToolButton:pressed {
    background-color: #45475a;
}

/* Push Buttons */
QPushButton {
    background-color: #89b4fa;
    color: #11111b;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #b4befe;
}

QPushButton:pressed {
    background-color: #74c7ec;
}

/* Input Fields */
QLineEdit, QSpinBox, QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 6px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #89b4fa;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #313244;
    background-color: #181825;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #11111b;
    color: #a6adc8;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #181825;
    color: #89b4fa;
    font-weight: bold;
    border-top: 2px solid #89b4fa;
}

/* Context Menus */
QMenu {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 8px;
}

/* Status Bar & Footer */
QStatusBar {
    background-color: #11111b;
    color: #a6adc8;
    border-top: 1px solid #313244;
    padding: 4px;
}

QSplitter::handle {
    background-color: #313244;
}
