{
  "manifest_version": 3,
  "name": "PyIDM Integration",
  "version": "1.0.0",
  "description": "Send download links directly to PyIDM desktop manager",
  "permissions": [
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8743/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}

