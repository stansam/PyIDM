{
  "manifest_version": 3,
  "name": "PyIDM Integration",
  "version": "1.1.0",
  "description": "Video download capture and link grabber for PyIDM desktop manager",
  "permissions": [
    "contextMenus",
    "downloads",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
